# identuum-idp-oss local development environment — example values only.
# Copy to dev.env.local (or dev.env) and adjust for your setup.
# NEVER commit dev.env.local. NEVER use these values in production.
#
# These credentials match deployment/docker-compose.dev.yml throwaway DB.
#
# How the binary reads config:
#   The default action (no subcommand) serves the full OSS IdP and reads its
#   configuration from the environment — see `identuum-idp help` and the
#   package doc in cmd/identuum-idp/main.go. The one-shot subcommands
#   (`migrate`, `bootstrap`, `recover-site-admin`, `show-setup-code`) take the
#   Postgres URL / data dir as a POSITIONAL argument and read their secrets from
#   the environment. Every variable below is read by the code (verified against
#   cmd/ and internal/); a URL or secret is never echoed, even on failure.

# ── Database ──────────────────────────────────────────────────────────────────

# URL for the local compose Postgres (port 5513 — avoids monolith 5432,
# AG monolith 5532, AG OSS 5533). Read by the serve action and passed
# positionally to the subcommands.
IDENTUUM_IDP_DATABASE_URL=postgres://idp_oss_user:dev-idp_oss_user-not-a-secret@127.0.0.1:5513/identuum_idp_oss?sslmode=disable

# Same URL used by the build-tagged integration test harness under
# internal/e2e/. The harness skips cleanly when both this and
# IDENTUUM_IDP_DATABASE_URL are unset.
IDENTUUM_IDP_TEST_DATABASE_URL=postgres://idp_oss_user:dev-idp_oss_user-not-a-secret@127.0.0.1:5513/identuum_idp_oss?sslmode=disable

# ── Encryption (at-rest MFA key) ──────────────────────────────────────────────

# At-rest AES key (32 bytes / 64 hex) read by the runtime as
# IDENTUUM_IDP_ENCRYPTION_KEY (fallback AUTH_SERVICE_ENCRYPTION_KEY) to encrypt
# MFA TOTP seeds. REQUIRED to serve: a missing/invalid key makes the process come
# up NOT-SERVING (503 on every route, fault on /health) by design (P-018). The
# container entrypoint auto-generates + persists one on first boot; when running
# the binary DIRECTLY you must set it. The constant below is a well-known PUBLIC
# dev value — safe ONLY for local dev; production MUST supply a real
# high-entropy key (`openssl rand -hex 32`), externally managed.
IDENTUUM_IDP_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# ── Serving (read by the default serve action) ────────────────────────────────

# Public issuer base URL advertised in OIDC discovery.
IDENTUUM_IDP_ISSUER=http://localhost:7113

# Listen address for the IdP (default 0.0.0.0:7113). NOTE: the code reads
# IDENTUUM_IDP_LISTEN — there is no IDENTUUM_IDP_BIND_ADDR.
IDENTUUM_IDP_LISTEN=127.0.0.1:7113

# Prometheus /metrics listen address — a SEPARATE, internal-only, UNAUTHENTICATED
# listener. DEFAULT: 127.0.0.1:9090 (LOOPBACK) so it is not reachable off-box.
# WARNING: the metric labels carry org_id and OIDC provider_id/provider_type, so
# exposing this endpoint leaks the organization + identity-provider inventory to
# any unauthenticated scanner. Set a ROUTABLE address (example below) ONLY to
# deliberately expose it, and restrict it at the network layer. "-" disables it.
#IDENTUUM_IDP_METRICS_ADDR=0.0.0.0:9090

# Trusted reverse-proxy addresses/CIDRs (comma-separated). DEFAULT: unset ⇒ trust
# NO proxy, so c.ClientIP() is the direct peer and a forged X-Forwarded-For
# cannot spoof rate limiting or audit/security-event attribution. If you run the
# IdP BEHIND a reverse proxy you MUST set this to the proxy's CIDR(s) or every
# client IP will be recorded as the proxy's.
#IDENTUUM_IDP_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# Deny-by-default CORS allowlist (comma-separated exact-match origins). Unset ⇒
# no cross-origin request is granted CORS access; same-origin is unaffected.
#IDENTUUM_IDP_CORS_ALLOWED_ORIGINS=http://localhost:7104

# Persistent data dir for the appliance setup foundation (setup-token.txt).
#IDENTUUM_IDP_DATA_DIR=/app/data

# ── Single-replica boundary (OSS is single-replica BY DESIGN) ──────────────────
# identuum-idp-oss runs as EXACTLY ONE replica. Its rate limiting, WebAuthn
# ceremony state, and browser CSRF secret are per-process and correct for one
# replica but SILENTLY BROKEN across replicas. On startup an instance acquires a
# DB-backed lease; a second instance REFUSES to serve (returns 503, /health
# reports the fault) instead of serving with broken security. Rolling deploys
# still work: the outgoing instance releases the lease (or its heartbeat lapses
# after the TTL) and the incoming instance takes over.
#
# Horizontal scaling / high availability is a Professional+ commercial
# capability. Set this to true ONLY to KNOWINGLY run multiple replicas; it
# disables the lease and prints a loud startup WARNING listing what degrades.
#IDENTUUM_IDP_ALLOW_MULTI_REPLICA=false

# Optional UI base URL used to compose the setup wizard URL in boot logs.
#IDENTUUM_IDP_UI_PUBLIC_BASE_URL=http://localhost:7104

# ── Operator one-shot subcommands (read secrets from the env) ──────────────────

# `identuum-idp bootstrap <url>` — create the site_admin + first signing key.
#IDENTUUM_IDP_BOOTSTRAP_PASSWORD=<choose-a-strong-local-demo-password>
#IDENTUUM_IDP_BOOTSTRAP_EMAIL=site_admin@system.local
#IDENTUUM_IDP_BOOTSTRAP_ALGORITHM=EdDSA

# `identuum-idp recover-site-admin <url>` — reset the site_admin password + MFA.
#IDENTUUM_IDP_RECOVER_SITE_ADMIN_PASSWORD=<choose-new-local-demo-password>

# ── Optional feature config (read by the runtime; production-oriented) ─────────
# Listed so nothing the code reads is undocumented. Defaults are sane for local
# dev, so these normally stay unset:
#   IDENTUUM_IDP_RATE_LIMIT_LOGIN_REQUESTS / _LOGIN_WINDOW
#   IDENTUUM_IDP_RATE_LIMIT_TOKEN_REQUESTS
#   IDENTUUM_IDP_RATE_LIMIT_INTROSPECTION_REQUESTS
#   IDENTUUM_IDP_RATE_LIMIT_REVOCATION_REQUESTS / _REVOCATION_WINDOW
#   IDENTUUM_IDP_RATE_LIMIT_PASSWORD_RESET_REQUESTS
#   IDENTUUM_IDP_SMTP_HOST / _PORT / _USERNAME / _PASSWORD / _FROM   (email delivery)
#   IDENTUUM_IDP_DATABASE_USER / _DATABASE_PASSWORD                  (URL-less DB creds)
#   IDENTUUM_IDP_REDIS_PASSWORD                                      (optional Redis cache)
#   IDENTUUM_IDP_PUBLIC_HIDE_IDP_EMAIL_DOMAINS                       (hide org email domains on public lookup)
#   DEFAULT_MAX_SESSIONS_PER_USER                                    (per-user session cap fallback)
